{
    "name": "khomerikik/eloquent-lens",
    "description": "A Horizon-like dashboard that visualizes your Eloquent models, relationships, scopes, observers, and more.",
    "keywords": ["laravel", "eloquent", "visualizer", "models", "relationships", "dashboard"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "EloquentLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EloquentLens\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EloquentLens\\EloquentLensServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
