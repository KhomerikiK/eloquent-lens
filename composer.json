{
    "name": "khomerikik/eloquent-lens",
    "description": "Visual dashboard for Laravel Eloquent models — see relationships, scopes, casts, policies, and complexity at a glance. No database queries.",
    "keywords": ["laravel", "eloquent", "models", "relationships", "visualizer", "erd", "diagram", "dashboard", "dev-tools", "schema", "scopes", "observers", "architecture"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "EloquentLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EloquentLens\\Tests\\": "tests/",
            "EloquentLens\\Tests\\Fixtures\\": "tests/Fixtures/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EloquentLens\\EloquentLensServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
